# =============================================================================
# Caixinha dos Amigos — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o arquivo `.env`.
# =============================================================================

# --- Banco de dados (PostgreSQL 16+) ----------------------------------------
# Desenvolvimento: `npm run db:start` liga um PostgreSQL 17 local (sem instalar nada),
# com dados em ./.postgres. Usuário/senha/porta abaixo são SÓ deste ambiente local.
LOCAL_PG_PORT="5433"
LOCAL_PG_USER="caixinha"
LOCAL_PG_PASSWORD=""
DATABASE_URL="postgresql://caixinha:SENHA_LOCAL@localhost:5433/caixinha_dev"
# Banco EXCLUSIVO para testes automatizados (é esvaziado a cada `npm test`).
# NUNCA aponte para produção.
TEST_DATABASE_URL="postgresql://caixinha:SENHA_LOCAL@localhost:5433/caixinha_test"
# Produção: PostgreSQL dedicado com TLS, ex.:
# DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/caixinha?sslmode=require"

# --- Autenticação ------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# URL pública da aplicação (sem barra no final)
BETTER_AUTH_URL="http://localhost:3000"

# --- E-mail (recuperação de acesso, convites, comunicados) -------------------
# Sem SMTP_HOST, os e-mails são gravados em ./.outbox (somente desenvolvimento).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Caixinha dos Amigos <nao-responda@exemplo.com>"

# --- Seed de demonstração (somente desenvolvimento; dados FICTÍCIOS) -----------
# Senha usada pelos usuários de demonstração criados por `npm run db:seed`.
DEV_SEED_PASSWORD=""

# --- Pix ------------------------------------------------------------------------
# "simulated" (testes, sem dinheiro real) | "manual" (conta da caixinha, conferência humana).
# Provedores reais (PSP) só após validação jurídica (Conformidade). Ver docs/integracoes.md.
PIX_PROVIDER="simulated"
# Segredo para assinar os webhooks do provedor (HMAC-SHA256, mín. 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PIX_WEBHOOK_SECRET=""
# Modo manual: chave Pix da CONTA DA CAIXINHA (estrutura jurídica). Nunca uma conta pessoal
# (chave do tipo CPF é recusada). Nome/cidade do recebedor: como aparecem no banco, sem acentos.
# Deixe vazio até haver a conta adequada.
PIX_MANUAL_KEY=""
PIX_MANUAL_RECEIVER_NAME=""
PIX_MANUAL_CITY=""

# --- Tarefas agendadas -----------------------------------------------------------
# Tarefa diária (lembretes de vencimento + expiração de cobranças Pix):
# GET/POST /api/tarefas/diarias com "Authorization: Bearer <CRON_SECRET>" (mín. 32 caracteres).
CRON_SECRET=""
